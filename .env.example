# RansomLeak tenant base URL. This is your own tenant, not a shared endpoint.
RANSOMLEAK_BASE_URL=https://your-subdomain.ransomleak.com

# Partner API token with the "integration" scope, created by a RansomLeak
# administrator under Settings -> Integrations -> API. Treat it as a secret:
# it can assign training to anyone in your tenant.
RANSOMLEAK_API_TOKEN=

# Your own email domains, comma separated. Required when reading an incident:
# an incident names attackers as well as victims, and this is what tells them
# apart. Without it the spoofed sender would be assigned training too.
RANSOMLEAK_EMAIL_DOMAINS=acme.com,acme.co.uk

# Slug of the lesson to assign. Any exercise in your catalog; pick something
# short enough to be a proportionate response to a single incident.
RANSOMLEAK_EXERCISE_SLUG=phishing-introduction

# Optional. RansomLeak POSTs here when the assignment is completed, so you can
# close the loop back into XDR or a ticket. Must be reachable from the public
# internet; leave blank if you do not need it.
RANSOMLEAK_CALLBACK_URL=
